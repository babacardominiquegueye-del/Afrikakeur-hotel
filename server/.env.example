# ---- Serveur ----
PORT=5000
CLIENT_URL=http://localhost:5173

# ---- Base de données (MongoDB Atlas) ----
MONGODB_URI=mongodb+srv://user:password@cluster.xxxxx.mongodb.net/afrika-keur?retryWrites=true&w=majority

# ---- Auth ----
JWT_SECRET=change-moi-avec-une-longue-chaine-aleatoire
JWT_EXPIRES=7d

# Compte admin créé automatiquement par le seed (npm run seed)
ADMIN_EMAIL=admin@hotelafrikakeur.sn
ADMIN_PASSWORD=change-moi

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=xxx
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx
# (alternative en une ligne) CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ---- Email (envoi des demandes de réservation, via SMTP) ----
# Exemple avec un SMTP classique (Hostinger, Gmail app password, etc.)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=reservations@hotelafrikakeur.sn
SMTP_PASS=mot-de-passe-email
# Destinataire des demandes de réservation
RESERVATION_TO=reservations@hotelafrikakeur.sn
