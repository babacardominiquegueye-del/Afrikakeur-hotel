{
  "name": "afrika-keur",
  "version": "1.0.0",
  "description": "Site vitrine + back-office du boutique hôtel Afrika Keur (MERN + Cloudinary)",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently -n API,WEB -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "build": "npm run build --prefix client",
    "seed": "npm run seed --prefix server",
    "migrate:photos": "npm run migrate:photos --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
